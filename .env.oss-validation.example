# =============================================================================
# SentinalAI — OSS validation gateway (clone-facing live path)
# =============================================================================
#   set -a && source .env.oss-validation.example && set +a
#
# Compose stack: deploy/oss-validation/docker-compose.yaml
# Walkthrough:   docs/clone/OSS_VALIDATION.md
#
# This is NOT production AgentCore. Stubs + INC12345 remain the zero-infra
# proof. This file is for GATEWAY_MODE=live against the local OSS shim.
# =============================================================================

GATEWAY_MODE=live
MCP_GATEWAY_URL=http://127.0.0.1:9080/mcp

# Defaults match workers/mcp_client.py — only set these if you overrode targets.
# AGENTCORE_TARGET_MOOGSOFT=MoogsoftTarget
# AGENTCORE_TARGET_SPLUNK=SplunkTarget
# AGENTCORE_TARGET_SYSDIG=SysdigTarget
# AGENTCORE_TARGET_SIGNALFX=SignalFxTarget
# AGENTCORE_TARGET_DYNATRACE=DynatraceTarget
# AGENTCORE_TARGET_KUBERNETES=KubernetesTarget

# Optional: YAML playbook that uses loki/prometheus aliases (flag off = hardcoded).
# YAML_PLAYBOOKS_ENABLED=true
# PLAYBOOKS_DIR=deploy/oss-validation/playbooks

LLM_ENABLED=false
LLM_PROVIDER=null

# Investigation id seeded by deploy/oss-validation/seed/seed.py
#   python scripts/run_investigation.py INC-OSS-001
